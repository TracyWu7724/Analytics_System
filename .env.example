# ── Databricks ────────────────────────────────────────────────────────────────
DATABRICKS_SERVER_HOSTNAME=<workspace>.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=<personal-access-token>
DATABRICKS_CATALOG=chatbot_mw
DATABRICKS_SCHEMA=default

# ── LLM providers (add whichever you use) ────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
# LANGCHAIN_API_KEY=ls__...   # optional LangSmith tracing
# OLLAMA_BASE_URL=http://localhost:11434

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET_KEY=<random-secret-min-32-chars>

# ── RAG embeddings ────────────────────────────────────────────────────────────
# Local path inside the container (populated from volume or S3 sync)
RAG_EMBED_DIR=/app/data/rag/embedding
RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── S3 index / embedding storage (optional) ───────────────────────────────────
# If set, entrypoint.sh syncs these from S3 before starting the server.
# Requires the EC2 instance to have an IAM role with s3:GetObject / s3:ListBucket.
# INDEX_S3_URI=s3://your-bucket/index/
# RAG_EMBED_S3_URI=s3://your-bucket/rag/embedding/

# ── Server ────────────────────────────────────────────────────────────────────
UVICORN_WORKERS=2

# ── Frontend ──────────────────────────────────────────────────────────────────
# Public URL of the backend — used at React build time (baked into the bundle)
REACT_APP_API_URL=http://<ec2-public-ip-or-domain>:8000
